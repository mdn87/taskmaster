{
 "schema": "taskmaster.batch2-cases/v1",
 "subject": "refresh publication, locking and whole-file reader handling",
 "plan_sections": ["6", "7", "8"],
 "status": "authored, not executed: Batch 2 must run each case against the real refresh command on Windows",
 "cases": [
  {"id": "pub-first-refresh", "setup": "no export.json, no lock holder", "action": "refresh",
   "expect": {"exit": 0, "export": "new file, verify-export ok"}},
  {"id": "pub-unchanged-content", "setup": "valid export from an identical earlier refresh", "action": "refresh at a later clock",
   "expect": {"exit": 0, "content_json": "byte-identical", "snapshot_id": "unchanged", "content_generated_at": "unchanged", "observation": "times advance"}},
  {"id": "pub-writer-busy", "setup": "second process holds the byte-range writer lock", "action": "refresh",
   "expect": {"exit": 6, "export": "bytes unchanged"}},
  {"id": "pub-lock-file-without-holder", "setup": "lock file exists, no process holds the lock", "action": "refresh",
   "expect": {"exit": 0, "lock_file": "not deleted"}},
  {"id": "pub-process-death-releases-lock", "setup": "writer process killed while holding the lock", "action": "refresh from a new process",
   "expect": {"exit": 0}},
  {"id": "pub-interrupted-before-replace", "setup": "writer killed after writing its unique temp file, before replace", "action": "show --all --json, then refresh",
   "expect": {"show": "previous export", "temp_file": "ignored by readers, never promoted, not deleted"}},
  {"id": "pub-replace-sharing-violation-transient", "setup": "reader holds export.json without delete sharing for under 1 s", "action": "refresh",
   "expect": {"exit": 0, "replace_attempts": "at most 5 with 100/200/400/800 ms delays"}},
  {"id": "pub-replace-sharing-violation-persistent", "setup": "reader holds export.json without delete sharing for the whole retry window", "action": "refresh",
   "expect": {"exit": 7, "code": "publication_failed", "export": "previous bytes unchanged"}},
  {"id": "pub-existing-export-invalid", "setup": "export.json has tampered content (trail hash mismatch)", "action": "refresh",
   "expect": {"exit": 4, "code": "existing_export_invalid", "export": "bytes unchanged"}},
  {"id": "pub-recover-invalid-export", "setup": "as pub-existing-export-invalid", "action": "refresh --recover-invalid-export",
   "expect": {"exit": 0, "invalid_copy": "unique timestamped .invalid sibling, verified byte-identical", "export": "rebuilt with no prior content"}},
  {"id": "pub-recover-preservation-fails", "setup": "as pub-existing-export-invalid, .invalid copy cannot be written", "action": "refresh --recover-invalid-export",
   "expect": {"exit_nonzero": true, "export": "bytes unchanged"}},
  {"id": "pub-objective-removed", "setup": "valid export with two objectives; config now lists one", "action": "refresh",
   "expect": {"exit": 0, "entries": "only the configured objective"}},
  {"id": "pub-objective-rebound-then-fails", "setup": "valid export; annotation locator changed; owner read fails", "action": "refresh",
   "expect": {"exit": 5, "content_json": null, "error_codes_include": ["config_changed", "required_source_failed"]}},
  {"id": "pub-over-bounds-isolated", "setup": "one objective whose escaped entry exceeds 80 KiB, one normal objective", "action": "refresh",
   "expect": {"exit": 5, "over_bounds_entry": "failed, null content", "other_entry": "ok"}},
  {"id": "read-missing", "setup": "no export.json", "action": "show --all --json",
   "expect": {"exit": 3}},
  {"id": "read-invalid", "setup": "export.json is malformed JSON", "action": "show --all --json",
   "expect": {"exit": 4, "code": "invalid_export"}},
  {"id": "read-unsupported", "setup": "export.json has schema_version 2", "action": "show --all --json",
   "expect": {"exit": 4, "code": "unsupported_export"}},
  {"id": "read-unreadable-sharing", "setup": "export.json held with no read sharing for longer than 150 ms", "action": "show --all --json",
   "expect": {"exit": 8, "read_attempts": "at most 3 with 50/100 ms delays"}},
  {"id": "read-restart", "setup": "valid export, all processes restarted", "action": "show --all --json",
   "expect": {"exit": 0, "snapshot_id": "same as before restart"}}
 ]
}
