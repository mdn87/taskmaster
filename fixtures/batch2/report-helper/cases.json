{
 "schema": "taskmaster.batch2-cases/v1",
 "subject": "delivered morning-report helper: block splicing, verification and status lines",
 "plan_sections": ["7"],
 "status": "authored, not executed: Batch 2 must check the final delivered report artifact, not only the renderer",
 "block_source": "fixtures/batch2/agreement/report.txt is the renderer output for agreement/export.json at --now 2026-10-17T12:00:00Z",
 "markers": "a fixed BEGIN/END pair chosen in Batch 2; the digest line covers the exact block bytes, excluding the markers and the digest line",
 "cases": [
  {"id": "rh-unconfigured", "setup": "Taskmaster not configured, empty inbox",
   "expect": {"report": "identical to today's helper output, including the early return", "renderer_invoked": false}},
  {"id": "rh-configured-empty-inbox", "setup": "configured, valid export, empty inbox",
   "expect": {"block_count": 1, "renderer_invocations": 1, "block_read_before_empty_inbox_return": true}},
  {"id": "rh-happy-path", "setup": "configured, valid agreement export, nonempty inbox",
   "expect": {"block_bytes": "equal to agreement/report.txt", "digest": "sha256 of those bytes", "inbox_items": "unchanged"}},
  {"id": "rh-export-missing", "setup": "configured, export.json absent",
   "expect": {"status_lines": 1, "block_count": 0, "inbox_processing": "continues"}},
  {"id": "rh-export-invalid", "setup": "configured, tampered export",
   "expect": {"status_lines": 1, "block_count": 0, "current_claimed": false, "inbox_processing": "continues"}},
  {"id": "rh-export-unsupported", "setup": "configured, schema_version 2 export",
   "expect": {"status_lines": 1, "block_count": 0, "inbox_processing": "continues"}},
  {"id": "rh-export-unreadable", "setup": "configured, export held without read sharing",
   "expect": {"status_lines": 1, "block_count": 0, "inbox_processing": "continues"}},
  {"id": "rh-renderer-launch-fails", "setup": "configured, taskmaster executable missing",
   "expect": {"status_lines": 1, "block_count": 0, "inbox_processing": "continues"}},
  {"id": "rh-renderer-nonzero", "setup": "renderer exits 3 for a missing objective selector",
   "expect": {"status_lines": 1, "block_count": 0}},
  {"id": "rh-refresh-race", "setup": "refresh replaces export.json between block insertion and verification",
   "expect": {"verification": "passes against the retained buffer", "export_reread": false, "renderer_invocations": 1, "block_snapshot_id": "the pre-refresh snapshot"}},
  {"id": "rh-block-modified", "setup": "one byte inside the delivered block changed",
   "expect": {"verification": "fails", "replacement": "one typed error line", "trail_summary_delivered": false, "rerendered": false}},
  {"id": "rh-block-omitted", "setup": "delivered artifact has no block",
   "expect": {"verification": "fails", "replacement": "one typed error line"}},
  {"id": "rh-block-duplicated", "setup": "delivered artifact has two blocks",
   "expect": {"verification": "fails", "replacement": "one typed error line"}},
  {"id": "rh-block-malformed-markers", "setup": "END marker missing",
   "expect": {"verification": "fails", "replacement": "one typed error line"}},
  {"id": "rh-crlf-translation", "setup": "artifact written in text mode on Windows so LF becomes CRLF inside the block",
   "expect": {"verification": "fails deterministically", "normalized": false}},
  {"id": "rh-final-newline", "setup": "renderer output ends with exactly one LF",
   "expect": {"block_bytes": "end with one LF, no extra newline added before the END marker"}}
 ]
}
